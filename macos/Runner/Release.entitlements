<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- No com.apple.security.network.client, on purpose: the app makes no
	     network requests, so the sandbox refuses any it might. Apple
	     Translate's language downloads are made by the system, not the app. -->
	<!-- Keep in step with DebugProfile.entitlements: a key missing from one
	     file shows up only in that build. -->
	<!-- Opening what the user picks in an open or save panel: project imports,
	     fonts, SVG shapes and images, all of which go through file_selector. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Exports land in ~/Downloads/MockMyApp. Inside the sandbox the
	     container's Downloads is a symlink to the real one, and writing
	     through it needs this. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
